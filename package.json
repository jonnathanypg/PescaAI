  "description": "MARINAFLUX — Ecosistema Modular de Logística y Operación Pesquera End-to-End",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && rm -rf dist/web && mkdir -p dist/web && cp -R src/web/* dist/web/",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "app": "open -na 'Google Chrome' --args --app=http://localhost:4000 --window-size=1280,820",
    "app:kiosk": "open -na 'Google Chrome' --args --app=http://localhost:4000 --window-size=430,860",
    "test:sim": "ts-node src/scripts/simulate_line.ts"
  },
  "dependencies": {
    "@agenticnucleus/whatsapp-multitenant": "^1.1.0",
    "@types/ws": "^8.18.2",
    "axios": "^1.7.2",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "form-data": "^4.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
