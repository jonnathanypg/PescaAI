# POC PescaAI - Entorno de Configuración
PORT=4000
NODE_ENV=development

# Base de Datos (sqlite o mysql)
DB_TYPE=sqlite
# Para SQLite:
SQLITE_DB_PATH=./pescaai_data.db

# Para MySQL Remoto Temporal (Dynamics AX staging replica)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tecopesca_staging

# Motor de Transcripción Whisper (media.weblifetech.com)
MEDIA_WHISPER_URL=https://media.weblifetech.com/api/external/transcribe
MEDIA_API_KEY=wlt_sec_tecopesca_poc_2026

# LEM Guardian (Determinismo y Validación Neurosimbólica)
LEM_API_URL=https://lem.weblifetech.com
LEM_API_KEY=lem_sec_tecopesca_pilot
LEM_SCHEMA=tecopesca_deslomado_v1

# WhatsApp Agentic Nucleus
WHATSAPP_SESSION_ID=tecopesca_control_tower
# Números autorizados separados por coma (Directivos / Supervisores)
AUTHORIZED_DIRECTIVE_NUMBERS=593999999999,593988888888
EMERGENCY_ALERT_NUMBERS=593999999999
